{
  "name": "photo-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS for photographers to sell photos, albums and downloads.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @photo-platform/api dev",
    "dev:web": "pnpm --filter @photo-platform/web dev",
    "build": "pnpm --filter @photo-platform/api build",
    "typecheck": "pnpm --filter @photo-platform/api typecheck",
    "lint": "pnpm --filter @photo-platform/api lint",
    "format": "pnpm --filter @photo-platform/api format",
    "test": "pnpm --filter @photo-platform/api test",
    "test:integration": "pnpm --filter @photo-platform/api test:integration",
    "db:generate": "pnpm --filter @photo-platform/api db:generate",
    "db:migrate": "pnpm --filter @photo-platform/api db:migrate",
    "db:seed": "pnpm --filter @photo-platform/api db:seed",
    "db:studio": "pnpm --filter @photo-platform/api db:studio",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "web:lint": "pnpm --filter @photo-platform/web lint",
    "web:typecheck": "pnpm --filter @photo-platform/web typecheck",
    "web:test": "pnpm --filter @photo-platform/web test",
    "web:build": "pnpm --filter @photo-platform/web build",
    "admin": "pnpm --filter @photo-platform/api admin"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8"
  }
}
