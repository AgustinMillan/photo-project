# Base domain of the platform. Hostnames like <slug>.<VITE_PLATFORM_DOMAIN> render
# the public storefront; any other hostname renders the photographer panel.
VITE_PLATFORM_DOMAIN=localhost

# Where the dev server proxies /api requests (the Fastify backend).
VITE_API_TARGET=http://localhost:3000

# Optional support address shown in the subscription page.
VITE_SUPPORT_EMAIL=
