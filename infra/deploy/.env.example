# Copy to infra/deploy/.env on the server and fill in. Never commit the real file.
# Generate secrets with: openssl rand -base64 48

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=

API_HOST_PORT=3100
LOG_LEVEL=info
APP_URL=https://fotos.example.com
CORS_ORIGIN=https://fotos.example.com
PLATFORM_DOMAIN=fotos.example.com

TRIAL_PLAN_CODE=base
TRIAL_DURATION_DAYS=30

# Until a transactional email provider is set up, emails are written to the
# API log (docker compose logs api) and accounts can be verified with
# `admin verify-email`. With a provider: EMAIL_TRANSPORT=smtp plus SMTP_*.
EMAIL_TRANSPORT=log
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@fotos.example.com
SUPPORT_EMAIL=

# Post-deploy smoke test (infra/deploy/smoke.py) uses a dedicated QA account.
SMOKE_EMAIL=
SMOKE_PASSWORD=
