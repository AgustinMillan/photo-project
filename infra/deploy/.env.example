# Copy to infra/deploy/.env on the server and fill in. Never commit the real file.
# Generate secrets with: openssl rand -base64 48

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=

API_HOST_PORT=3100
LOG_LEVEL=info
APP_URL=https://fotos.example.com
CORS_ORIGIN=https://fotos.example.com
PLATFORM_DOMAIN=fotos.example.com

TRIAL_PLAN_CODE=base
TRIAL_DURATION_DAYS=30

# Until a transactional email provider is set up, emails are written to the
# API log (docker compose logs api) and accounts can be verified with
# `admin verify-email`. With a provider: EMAIL_TRANSPORT=smtp plus SMTP_*.
EMAIL_TRANSPORT=log
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@fotos.example.com
SUPPORT_EMAIL=

# Post-deploy smoke test (infra/deploy/smoke.py) uses a dedicated QA account.
SMOKE_EMAIL=
SMOKE_PASSWORD=

# Mercado Pago marketplace (each photographer connects their own account).
# Leave MP_CLIENT_ID empty to keep the integration disabled.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
MP_USE_PKCE=false
# Commission retained by the platform on each Mercado Pago sale (percent).
PLATFORM_FEE_PERCENT=0
# 32 random bytes in base64 (openssl rand -base64 32). Encrypts stored tokens.
# Changing it disconnects every Mercado Pago account.
TOKEN_ENCRYPTION_KEY=
