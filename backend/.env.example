NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL 17 from infra/docker-compose.yml
DATABASE_URL=postgres://photo_platform:photo_platform_dev@localhost:5432/photo_platform

# Use a different database for automated tests.
# DATABASE_URL=postgres://photo_platform:photo_platform_dev@localhost:5432/photo_platform_test

LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
# Base domain used for platform storefront subdomains.
PLATFORM_DOMAIN=localhost

# Generate a real secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=photo-platform
JWT_AUDIENCE=photo-platform-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
STORE_INVITATION_TTL_DAYS=7
# Provisional Phase 2 trial configuration. Plans and entitlements live in the
# database and can be changed without deploying code.
TRIAL_PLAN_CODE=base
TRIAL_DURATION_DAYS=30

# Development email catcher (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@photo-platform.local
